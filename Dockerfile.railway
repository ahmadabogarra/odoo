FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Railway startup creates and uses a dedicated PostgreSQL role for Odoo.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    make \
    pkg-config \
    ca-certificates \
    git \
    postgresql-client \
    libpq-dev \
    libldap2-dev \
    libsasl2-dev \
    libssl-dev \
    libffi-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    libxml2-dev \
    libxslt1-dev \
    libmagic1 \
    nodejs \
    npm \
    gettext \
    fontconfig \
    fonts-dejavu-core \
    fonts-freefont-ttf \
    fonts-noto-core \
    gosu \
    && npm install -g rtlcss \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --home-dir /var/lib/odoo --user-group odoo \
    && mkdir -p /var/lib/odoo \
    && chown -R odoo:odoo /var/lib/odoo

WORKDIR /opt/odoo

COPY requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r requirements.txt

COPY --chown=odoo:odoo . /opt/odoo

# OCA account_usability 20.0, pinned for reproducible production builds.
# Upstream: https://github.com/OCA/account-financial-tools/tree/20.0/account_usability
ARG OCA_ACCOUNT_FINANCIAL_TOOLS_COMMIT=fca00f802a8802560a04e0941d779236a01f5e0c
RUN git init /tmp/oca-account-financial-tools \
    && cd /tmp/oca-account-financial-tools \
    && git remote add origin https://github.com/OCA/account-financial-tools.git \
    && git fetch --depth 1 origin ${OCA_ACCOUNT_FINANCIAL_TOOLS_COMMIT} \
    && git checkout FETCH_HEAD -- account_usability \
    && cp -a account_usability /opt/odoo/addons/account_usability \
    && chown -R odoo:odoo /opt/odoo/addons/account_usability \
    && rm -rf /tmp/oca-account-financial-tools

RUN chmod +x /opt/odoo/railway-entrypoint.sh

EXPOSE 8069

CMD ["/opt/odoo/railway-entrypoint.sh"]
